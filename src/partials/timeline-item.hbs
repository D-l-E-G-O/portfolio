<div class="timeline-item {{layout}}">
    <article class="timeline-content">

        {{#if is_job}}
        <!-- Layout pour les expériences professionnelles -->
        <span class="card-date">{{date}}</span>
        <h3 class="card-title">{{subject}}</h3>
        <h3 class="card-subtitle">
            Chez : <a class="job-company" href="https://www.insimo.com/fr/">{{company}}</a>
        </h3>

        <div class="job-meta">
            <span class="job-contract">{{contract}} de {{duration}}</span>
            <span class="job-location">{{location}}</span>
        </div>
        {{else}}
        <!-- Layout pour les projets -->
        <span class="card-date">{{date}}</span>
        <h3 class="card-title">{{title}}</h3>
        <p class="card-desc">{{description}}</p>
        <div class="project-meta">
            <span>Durée : {{duration}}</span>
            <span>{{devs}} développeur(s)</span>
        </div>
        {{/if}}

        <!-- Technologies -->
        {{#if tech}}
        <div class="card-badges" aria-label="Technologies utilisées">
            {{#each tech}}
            <span class="tech-badge" style="--badge-color: {{color}}">{{name}}</span>
            {{/each}}
        </div>
        {{/if}}

        <!-- Liens vers les repo -->
        {{#if repo}}
        <a href="{{repo}}" target="_blank" rel="noopener noreferrer" class="card-link">Voir le projet</a>
        {{/if}}

    </article>
</div>